# CONTENTSTACK INTELLIGENCE HUB — Next.js server-side environment configuration
# Copy to .env.local and fill in secrets locally. Never commit .env.local.
# Do not use NEXT_PUBLIC_ for any secret.

# Real Contentstack inventory as the default when credentials are present.
DATA_MODE=live
# Choose the actual region: https://api.contentstack.io | https://eu-api.contentstack.com
# https://au-api.contentstack.com | https://azure-na-api.contentstack.com
# https://azure-eu-api.contentstack.com | https://gcp-na-api.contentstack.com
# https://gcp-eu-api.contentstack.com
CONTENTSTACK_API_BASE_URL=https://api.contentstack.io
CONTENTSTACK_API_KEY=
CONTENTSTACK_MANAGEMENT_TOKEN=
CONTENTSTACK_BRANCH=main
# Set only if needed for scope/required market calculations; don't guess master locale
CONTENTSTACK_MASTER_LOCALE=
# Optional environment UID for publication checks
CONTENTSTACK_ENVIRONMENT=

# Prefer separate write-scope credential and non-production branch/stack.
# Production implementation must NOT use this variable for reads.
CONTENTSTACK_WRITE_TOKEN=
# Writes only ever touch these entry UIDs (comma-separated test entries). Empty = nothing writable.
CMS_WRITE_ALLOWED_ENTRY_UIDS=
ENABLE_CMS_WRITES=false
ENABLE_CMS_PUBLISH=false

# Live AI proposal generation. Model MUST be verified for user's account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
AI_MAX_USD_PER_BATCH=2.00
# Prices YOU configure (USD per 1M tokens). Unset => cost shows as "—", never $0.
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=
AI_SEND_CONTENT_TO_OPENAI=false

# UI demo/fixture fallback; demo and live status must always be visible.
NEXT_PUBLIC_APP_NAME=Contentstack Intelligence Hub

# Scan bounds and policy
SCAN_MAX_ENTRIES_PER_TYPE=200
CRITICAL_LOCALES=
HUB_ACTOR_ID=reviewer@local
